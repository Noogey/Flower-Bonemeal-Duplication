{
  "schemaVersion": 1,
  "id": "flowerbonemeal",
  "version": "${version}",
  "name": "Flower Bone Meal Duplication",
  "description": "Bone meal makes flowers drop a copy of themselves, filling the gaps vanilla leaves. Settings in config/flowerbonemeal.json or through Mod Menu.",
  "authors": [
    "Noogey"
  ],
  "contact": {
    "sources": "https://github.com/Noogey/Flower-Bonemeal-Duplication",
    "issues": "https://github.com/Noogey/Flower-Bonemeal-Duplication/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "modmenu": [
      "com.flowerbonemeal.client.ModMenuIntegration"
    ]
  },
  "mixins": [
    "flowerbonemeal.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
